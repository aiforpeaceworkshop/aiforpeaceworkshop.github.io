{
  "name": "aiforpeace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && mkdir -p dist/iclr-2026 dist/first-edition && cp dist/index.html dist/iclr-2026/index.html && cp dist/index.html dist/first-edition/index.html && cp dist/index.html dist/404.html",
    "check": "npm run lint && npm run check:content && npm run check:schedule && npm run build",
    "check:content": "node scripts/check_content.mjs",
    "check:schedule": "node scripts/check_schedule.mjs",
    "lint": "oxlint",
    "publish:legacy": "npm run build && node scripts/sync_pages_root.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
